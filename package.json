{
  "name": "easyresearch",
  "version": "0.0.8",
  "description": "Automated academic paper writing CLI built on the Pi agent harness",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hdu-ailab/EasyResearch.git"
  },
  "keywords": [
    "research",
    "paper-writing",
    "cli",
    "ai",
    "academic"
  ],
  "files": [
    "src",
    "README.md",
    "AGENTS.md"
  ],
  "piConfig": {
    "name": "easyresearch",
    "configDir": ".easyresearch"
  },
  "module": "src/cli/index.ts",
  "bin": {
    "easyresearch": "./src/cli/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config src/webui/vite.config.ts",
    "format:web": "biome format --write src/webui vitest.config.ts",
    "lint:web": "biome check src/webui vitest.config.ts",
    "check:web": "bun run typecheck && bun run test && bun run build:web && bun run lint:web",
    "prepack": "bun run build:web",
    "build:release": "bun scripts/build.ts",
    "release": "bun scripts/release.ts",
    "dev": "bun run src/cli/index.ts",
    "dev:web": "vite --config src/webui/vite.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@tanstack/react-virtual": "3.14.9",
    "cheerio": "1.1.2",
    "chokidar": "4.0.3",
    "katex": "0.18.1",
    "lucide-react": "1.28.0",
    "mermaid": "11.16.1",
    "htmlparser2": "10.0.0",
    "turndown": "7.2.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "4.7.0",
    "bun-types": "1.3.14",
    "jsdom": "30.0.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
