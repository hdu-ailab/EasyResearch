{
  "name": "lazyresearch",
  "version": "0.1.0",
  "description": "Automated academic paper writing CLI built on the Pi agent harness",
  "type": "module",
  "private": false,
  "files": [
    "src",
    "README.md",
    "AGENTS.md"
  ],
  "piConfig": {
    "name": "lazyresearch",
    "configDir": ".lazyresearch"
  },
  "module": "src/cli/index.ts",
  "bin": {
    "lazyresearch": "./src/cli/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config src/webui/vite.config.ts",
    "prepack": "bun run build:web",
    "dev": "bun run src/cli/index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "bun-types": "1.3.14",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
